{
  "name": "flyrank-capstone-image-relevance",
  "version": "1.0.0",
  "description": "FlyRank capstone: AI image understanding and content matching engine.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env src/server.js",
